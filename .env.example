# Copy to .env and fill in real values. NEVER commit a filled-in .env.
#
# Env model:
#   .env       -> dev / local defaults (this template). Loaded by hardhat.config.js.
#   .env.prod  -> Polygon MAINNET non-secret config (see .env.prod.example).
#                 Loaded only via `npm run deploy:mainnet` (dotenv -e .env.prod).
# The mainnet deployer key (PRIVATEKEYMAINNET) is NEVER stored in any file — it is
# shell-injected for the single mainnet deploy command only. See .env.prod.example.

# === Deployer Keys ===
# Testnet/dev key (sepolia, amoy). NEVER holds mainnet value.
# Default below is the public Hardhat dev account #0 — safe for local only.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# === RPC Providers (testnet/dev) ===
AMOY_RPC_URL=
INFURA_API_KEY=YOUR_INFURA_API_KEY

# === Contract Verification (Etherscan V2 unified key, routes by chainid) ===
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# === OpenAdverts (dev stand-in) ===
# Hardhat dev account #4 — safe local-only placeholder, rejected on mainnet by scripts/deploy.js.
OPENADVERTS_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707

# === Frontend / Governance (dev signer) ===
# Written on-chain in VoxGovernanceFacet.initialize(); verifies chapter-creation signatures.
SIGNING_ADDRESS_FE="0xYOUR_DEV_FRONTEND_SIGNING_ADDRESS"

# === Request-auth key (published on-chain, rotates with ownership) ===
# Public requestKey seeded via VoxRequestKeyFacet.setRequestKey at deploy. The signing service
# authenticates request callers against getRequestKey(). MUST differ from SIGNING_ADDRESS_FE and the
# deployer/owner (both enforced on-chain and by scripts/deploy.js). Private key is server-side only.
REQUEST_KEY_ADDRESS_FE="0xYOUR_DEV_REQUEST_KEY_ADDRESS"

# === Optional ===
# REPORT_GAS=true
