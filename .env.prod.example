# Copy to .env.prod and fill in real MAINNET values. NEVER commit a filled-in .env.prod.
#
# Loaded ONLY for mainnet deploys via: npm run deploy:mainnet
#   (which runs: dotenv -e .env.prod -- hardhat run scripts/deploy.js --network polygon)
#
# This file holds NON-SECRET mainnet config only. It MUST be complete for every
# mainnet-relevant variable, because values omitted here would otherwise fall
# through to whatever is left in .env.
#
# The mainnet deployer private key is NOT stored here (or in any file). Inject it
# into the shell for the single deploy command only. On PowerShell (Windows):
#   $env:PRIVATEKEYMAINNET = "0x<dedicated mainnet owner EOA key>"
#   npm run deploy:mainnet
# Prefer a hardware wallet / KMS signer over a raw key for mainnet.

# === Mainnet opt-in gate (required by scripts/deploy.js) ===
# Deliberate human confirmation. Set to 1 ONLY when you really mean to broadcast
# to Polygon mainnet; leave blank otherwise. You can instead set it in the shell
# ($env:I_UNDERSTAND_MAINNET = "1") — a shell value is NOT overridden by this file.
I_UNDERSTAND_MAINNET=

# === RPC Provider (mainnet) ===
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# === Contract Verification (Etherscan V2 unified key, routes by chainid) ===
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# === Polygon Mainnet Contracts ===
# Chainlink POL/USD feed (8 decimals). Confirm code + decimals() on Polygonscan before mainnet.
POLYGON_POL_USD_FEED=0xAB594600376Ec9fD91F8e885dADF0CE036862dE0
# OpenAdverts (formerly Advolution) USDC reward source contract. Real mainnet address
# required — the dev fallback (Hardhat #4) is rejected on mainnet by scripts/deploy.js.
OPENADVERTS_ADDRESS=0x0165878A594ca255338adfa4d48449f69242Eb8F

# === Frontend / Governance (production signer) ===
# Written on-chain in VoxGovernanceFacet.initialize(); verifies chapter-creation signatures.
SIGNING_ADDRESS_FE="0xYOUR_PROD_FRONTEND_SIGNING_ADDRESS"

# === Request-auth key (published on-chain, rotates with ownership) ===
# Public requestKey seeded via VoxRequestKeyFacet.setRequestKey at deploy. MUST differ from
# SIGNING_ADDRESS_FE and the deployer/owner. Private key is server-side only, never in any file.
REQUEST_KEY_ADDRESS_FE="0xYOUR_PROD_REQUEST_KEY_ADDRESS"
